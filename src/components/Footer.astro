---
import { personalData } from '../data/personal.js';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {year} {personalData.name}</p>
    <nav class="footer-links" aria-label="Contact links">
      <a href={personalData.socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={personalData.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={`mailto:${personalData.socialLinks.mail}`}>Email</a>
      <a href="/timeline">Trail</a>
    </nav>
    <p class="footer-note">Ahmedabad · IIT Gandhinagar<br />Built as a record of questions in motion.</p>
  </div>
</footer>
