---
const navItems = [
  { label: 'Index', href: '/' },
  { label: 'Questions', href: '/questions' },
  { label: 'Work', href: '/projects' },
  { label: 'Notes', href: '/notes' },
  { label: 'About', href: '/about' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" transition:persist="atlas-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Aaditya Shah, home">
      <span class="brand-mark" aria-hidden="true">A</span>
      <span class="brand-copy"><strong>Aaditya Shah</strong><span>Questions worth staying with</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a data-nav-link href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle day and night theme" title="Toggle theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/></svg>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" data-mobile-nav data-open="false" aria-label="Mobile navigation">
    {navItems.map((item) => <a data-nav-link href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>

<script>
  const initHeader = () => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-mobile-nav]');
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const active = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    toggle.onclick = () => {
      const open = nav.dataset.open !== 'true';
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      nav.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
    }));
  };
  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>
