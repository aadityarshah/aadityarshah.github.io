---
import DarkModeToggle from './DarkModeToggle.astro';
import { personalData } from '../data/personal.js';

const navItems = [
  { name: 'Home', href: '/', isIcon: true },
  { name: 'Posts', href: '/posts' },
  { name: 'Projects', href: '/projects' },
  { name: 'Tags', href: '/tags' },
  { name: 'Toolkit', href: '/toolkit' },
];

const pathname = new URL(Astro.request.url).pathname;
const normalizedPathname = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
---

<header 
  transition:persist
  class="sticky top-0 z-50 w-full bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200/50 dark:border-slate-800/50"
>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Brand Area -->
      <div class="flex items-center gap-3 min-w-[180px]">
        <a href="/" class="relative flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-700 shadow-lg shadow-blue-500/20 hover:scale-110 hover:rotate-3 transition-all duration-300" aria-label="Home">
          <div class="absolute inset-0 rounded-xl bg-white/10 backdrop-blur-[1px]"></div>
        </a>
        <a 
          href={personalData.socialLinks.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hidden sm:inline-block text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap"
        >
          {personalData.name}
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center bg-slate-100 dark:bg-slate-900/50 p-1 rounded-full border border-slate-200 dark:border-slate-800">
        {navItems.map((item, index) => {
          const isActive = normalizedPathname === item.href || (item.href !== '/' && normalizedPathname.startsWith(item.href));
          
          return (
            <>
              {item.isIcon ? (
                <a
                  href={item.href}
                  data-nav-link
                  data-href={item.href}
                  data-is-icon="true"
                  class={`px-4 py-2 transition-all duration-200 flex items-center justify-center relative ${
                    isActive 
                      ? 'text-slate-900 dark:text-white nav-active' 
                      : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100'
                  }`}
                  aria-label={item.name}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                  </svg>
                  {isActive && <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-white active-dot"></div>}
                </a>
              ) : (
                <a
                  href={item.href}
                  data-nav-link
                  data-href={item.href}
                  class={`px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200 flex items-center justify-center ${
                    isActive 
                      ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-950 shadow-md nav-active' 
                      : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-white/50 dark:hover:bg-slate-800/20'
                  }`}
                >
                  {item.name}
                </a>
              )}
              {index === 0 && <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 mx-1"></div>}
            </>
          );
        })}
      </div>

      <!-- Action Area -->
      <div class="flex items-center gap-3 sm:gap-6 min-w-[120px] justify-end">
        <div class="flex items-center gap-1 sm:gap-3">
          <a
            href={personalData.socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-full transition-all"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href={`mailto:${personalData.socialLinks.mail}`}
            class="p-2 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-full transition-all"
            aria-label="Email"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
        <div class="h-6 w-px bg-slate-200 dark:bg-slate-800"></div>
        <DarkModeToggle />
      </div>
    </div>
  </nav>
</header>

<script>
  /**
   * Since we're using transition:persist, we need to manually 
   * update the active tab state in the persistent header 
   * when the page content changes.
   */
  const updateActiveTab = () => {
    const pathname = window.location.pathname;
    const normalizedPathname = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
    
    const links = document.querySelectorAll('[data-nav-link]');
    links.forEach(link => {
      const href = link.getAttribute('data-href');
      const isIcon = link.getAttribute('data-is-icon') === 'true';
      const isActive = normalizedPathname === href || (href !== '/' && normalizedPathname.startsWith(href));
      
      // Reset classes
      link.className = link.className.replace(/bg-slate-900|text-white|dark:bg-white|dark:text-slate-950|shadow-md|nav-active|text-slate-900|dark:text-white|text-slate-500|dark:text-slate-400|text-slate-600|hover:text-slate-900|dark:hover:text-slate-100|hover:bg-white\/50|dark:hover:bg-slate-800\/20/g, '').trim();
      
      // Remove dot if exists
      const existingDot = link.querySelector('.active-dot');
      if (existingDot) existingDot.remove();

      if (isActive) {
        link.classList.add('nav-active');
        if (isIcon) {
          link.classList.add('text-slate-900', 'dark:text-white', 'px-4', 'py-2', 'transition-all', 'duration-200', 'flex', 'items-center', 'justify-center', 'relative');
          const dot = document.createElement('div');
          dot.className = 'absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-white active-dot';
          link.appendChild(dot);
        } else {
          link.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950', 'shadow-md', 'px-5', 'py-2', 'rounded-full', 'text-sm', 'font-semibold', 'transition-all', 'duration-200', 'flex', 'items-center', 'justify-center');
        }
      } else {
        if (isIcon) {
          link.classList.add('text-slate-500', 'dark:text-slate-400', 'px-4', 'py-2', 'transition-all', 'duration-200', 'flex', 'items-center', 'justify-center', 'relative');
        } else {
          link.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'dark:hover:text-slate-100', 'hover:bg-white/50', 'dark:hover:bg-slate-800/20', 'px-5', 'py-2', 'rounded-full', 'text-sm', 'font-semibold', 'transition-all', 'duration-200', 'flex', 'items-center', 'justify-center');
        }
      }
    });
  };

  document.addEventListener('astro:page-load', updateActiveTab);
</script>
