---
import { personalData } from '../data/personal.js';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = `${personalData.name} - Your short description goes here` } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter prefetch="hover" />
    <script is:inline>
      const setTheme = () => {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        })();
      
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
        window.localStorage.setItem('theme', theme);
      };

      const toggleTheme = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      };
      
      setTheme();
      document.addEventListener('astro:after-swap', setTheme);
      
      // Global delegated listener for the dark mode toggle
      // This is the most reliable way to handle clicks on persistent elements
      document.addEventListener('click', (e) => {
        const toggle = e.target.closest('#dark-mode-toggle');
        if (toggle) {
          toggleTheme();
        }
      });
      
      // Make toggleTheme available globally just in case
      window.toggleTheme = toggleTheme;
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen relative overflow-x-hidden">
    <!-- Optimized Mesh Gradient Background -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none opacity-50 dark:opacity-30">
      <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-blue-400/20 blur-[120px] will-change-transform"></div>
      <div class="absolute top-[20%] -right-[10%] w-[35%] h-[35%] rounded-full bg-indigo-400/20 blur-[120px] will-change-transform"></div>
      <div class="absolute bottom-[10%] left-[20%] w-[30%] h-[30%] rounded-full bg-sky-400/20 blur-[120px] will-change-transform"></div>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    scroll-behavior: smooth;
    /* Prevent layout shift when scrollbar appears/disappears */
    scrollbar-gutter: stable;
    /* Optimize rendering */
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  /* Global Faster Animation */
  .animate-speed-fast {
    animation-duration: 400ms !important;
  }

  /* Global style for links to make them clearer */
  a {
    transition: all 0.2s ease-in-out;
  }

  /* Target text-based links while avoiding most buttons/header items */
  p a, 
  article a, 
  li a, 
  .prose a,
  [set\:html] a {
    color: #2563eb; /* Bold blue for light mode */
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .dark p a, 
  .dark article a, 
  .dark li a, 
  .dark .prose a,
  .dark [set\:html] a {
    color: #93c5fd; /* Lighter blue for dark mode */
  }

  p a:hover, 
  article a:hover, 
  li a:hover, 
  .prose a:hover,
  [set\:html] a:hover {
    opacity: 0.8;
    border-bottom-color: currentColor;
  }
</style>
