---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EnigmaReconstruction from '../components/EnigmaReconstruction.astro';
import { personalData } from '../data/personal.js';
import { entrySlug, formatDate, getAtlasContent } from '../lib/atlas';
const { investigations, notes, trail } = await getAtlasContent();
const selectedWorks = investigations.filter(item => item.data.homepageFeatured && item.id !== 'enigma-cryptanalysis');
const latestNote = notes[0];
const recentUpdates = trail.slice(0, 3);
---
<Layout title="Aaditya Shah — Mathematics, computation & experiments" description="CSE undergraduate at IIT Gandhinagar. Enigma cryptanalysis, contributions to quantum software, and experiments in computation.">
  <Header />
  <main id="main-content" class="notebook-home">
    <section class="shell introduction" aria-labelledby="intro-title">
      <div><h1 id="intro-title">Aaditya Shah</h1><p class="intro-line">Studying computation through<br class="desktop-break" /> mathematics and experiments.</p></div>
      <div class="intro-bio"><p>I’m a second-year CSE undergraduate at IIT Gandhinagar, graduating in 2029. My current work spans Enigma cryptanalysis, quantum software contributions, and a quantum simulator in C. I’ve also started exploring computational complexity theory and its connections to quantum computing.</p><div class="intro-links"><a href="/about/">More about me</a><a href="/questions/">Current questions</a></div></div>
    </section>
    <section class="shell work-section" aria-labelledby="work-heading">
      <div class="notebook-heading"><h2 id="work-heading">Selected work</h2><a href="/projects/" class="section-link">All projects</a></div>
      <article class="research-feature">
        <div class="research-copy">
          <div class="work-context meta"><span>Research</span><span class="work-state">Ongoing</span></div>
          <h3><a href="/projects/enigma-cryptanalysis/">Recovering hidden<br class="desktop-break" /> structure from Enigma.</a></h3>
          <p>How much of a machine’s internal wiring can intercepted messages reveal? I’m investigating rotor recovery through permutations, group theory, and simulation.</p>
          <p class="research-finding"><strong>Current question</strong> Knowing one rotor exactly can still leave uncertainty in the others. What further information lets us recover their wiring?</p>
          <div class="intro-links"><a href="/projects/enigma-cryptanalysis/">Read the investigation</a><a href="https://github.com/aadityarshah/srip-2026" target="_blank" rel="noopener noreferrer">Research code</a></div>
        </div>
        <EnigmaReconstruction compact />
      </article>
      <div class="work-index">{selectedWorks.map((work) => <article class="work-entry">

        <div class="work-entry-title"><p class="meta">{work.data.category}</p><h3><a href={'/projects/' + work.id + '/'}>{work.data.homepageTitle ?? work.data.title}</a></h3><span class="work-state">{work.id === 'open-source-contributions' ? 'Merged contributions' : work.data.status === 'complete' ? 'Complete' : work.data.status}</span></div>
        <div class="work-entry-detail"><p>{work.data.homepageSummary ?? work.data.summary}</p><div class="evidence-links">{work.data.evidence.filter(item => work.id !== 'open-source-contributions' || item.label.startsWith('Merged')).slice(0, 2).map(item => <a href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label}</a>)}</div></div>
      </article>)}</div>
    </section>
    <section class="shell notebook-updates" aria-label="Recent activity and writing">
      <div class="activity-column"><div class="notebook-heading"><h2>Recent activity</h2><a href="/timeline/" class="section-link">Full trail</a></div><ol class="activity-list">{recentUpdates.map(entry => <li><time class="meta" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><h3><a href={entry.data.url ?? '/timeline/'}>{entry.data.title}</a></h3><p>{entry.data.summary}</p></li>)}</ol></div>
      {latestNote && <div class="writing-column"><div class="notebook-heading"><h2>Recent writing</h2><a href="/notes/" class="section-link">All notes</a></div><article class="writing-feature"><p class="meta">{formatDate(latestNote.data.date)}</p><h3><a href={'/notes/' + entrySlug(latestNote) + '/'}>{latestNote.data.title}</a></h3><p>{latestNote.data.description}</p><a class="text-link" href={'/notes/' + entrySlug(latestNote) + '/'}>Read the essay</a></article><p class="notebook-aside">This is a working notebook. Questions stay open, experiments change the explanation, and the writing follows.</p></div>}
    </section>
    <section class="shell contact-strip"><div><p class="eyebrow">Get in touch</p><h2>Have a question in common?</h2><p>I’d be glad to talk about mathematics, quantum computing, or something you’re building.</p></div><a class="button primary" href={'mailto:' + personalData.socialLinks.mail}>Write to me</a></section>
  </main>
  <Footer />
</Layout>
