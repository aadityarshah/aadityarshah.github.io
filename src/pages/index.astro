---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuestionConstellation from '../components/QuestionConstellation.astro';
import { personalData } from '../data/personal.js';
import { entrySlug, formatDate, getAtlasContent } from '../lib/atlas';

const { questions, investigations, notes, trail } = await getAtlasContent();
const selectedWorks = investigations.filter((item) => item.data.homepageFeatured);
const homepageQuestions = questions.filter((question) => ['active investigation', 'foundational reading'].includes(question.data.status)).slice(0, 2);
const latestNote = notes[0];
---

<Layout title={`${personalData.name} — Questions worth staying with`}>
  <Header />
  <main id="main-content">
    <section class="shell hero" data-pointer-field>
      <div class="hero-copy" data-reveal>
        <h1 class="display hero-title">I like staying with difficult questions.</h1>
        <p class="hero-lede">A portfolio and research notebook about mathematics, computation, and engineering—through the questions I explore, projects I build, and notes I make along the way.</p>
        <p class="hero-context">I’m Aaditya Shah, a second-year B.Tech student in Computer Science and Engineering at IIT Gandhinagar, graduating in 2029.</p>
        <div class="hero-actions">
          <a class="button primary" href="/projects">Explore my projects <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="/questions">See the questions I’m following <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-footnote meta"><span>IIT Gandhinagar</span><span>2026</span></div>
      </div>
      <QuestionConstellation />
    </section>

    {selectedWorks.length > 0 && <section class="section selected-work-section" id="selected-work" data-reveal>
      <div class="shell">
        <header class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title">Questions, taken into the world.</h2><p class="section-intro">Research, systems, open source, and product engineering—each with a trail you can follow.</p></div><a class="section-link" href="/projects">All investigations →</a></header>
        <div class="selected-work-list">
          {selectedWorks.map((work) => <article class="selected-work-row">
            <div class="selected-work-meta meta"><span>{work.data.category}</span>{work.data.context && <span>{work.data.context}</span>}</div>
            <div class="selected-work-copy"><h3><a href={`/projects/${work.id}/`}>{work.data.homepageTitle ?? work.data.title}<span aria-hidden="true">↗</span></a></h3>
            <p>{work.data.homepageSummary ?? work.data.summary}</p></div>
            <footer class="selected-work-links">
              {work.data.evidence.slice(0, 1).map((item) => <a href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label} <span aria-hidden="true">↗</span></a>)}
            </footer>
          </article>)}
        </div>
      </div>
    </section>}

    <section class="section" id="questions" data-reveal>
      <div class="shell">
        <header class="section-head"><div><p class="eyebrow">Current Questions</p><h2 class="section-title">Questions I am following.</h2></div><a class="section-link" href="/questions">All questions →</a></header>
        <div class="question-grid current-question-grid">
          {homepageQuestions.map((question, index) => <a class="question-card" href={`/questions/${question.id}/`}><span class="index-number">Q.{String(index + 1).padStart(2, '0')}</span><h3>{question.data.title}</h3><p>{question.data.summary}</p><footer><span class="status">{question.data.status}</span><span class="topic">{question.data.domains[0]}</span></footer></a>)}
        </div>
      </div>
    </section>

    {latestNote && <section class="section last-section" data-reveal>
      <div class="shell latest-note"><div><p class="eyebrow">Latest note</p><h2 class="section-title">From the notebook.</h2></div><div><time class="meta" datetime={latestNote.data.date.toISOString()}>{formatDate(latestNote.data.date)}</time><h3><a href={`/notes/${entrySlug(latestNote)}/`}>{latestNote.data.title}</a></h3><p>{latestNote.data.description}</p><a class="section-link" href="/notes">Read all notes →</a></div></div>
    </section>}
  </main>
  <Footer />
</Layout>
