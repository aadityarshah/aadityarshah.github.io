---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import newsData from '../data/news.json';
import projectsData from '../data/projects.json';
import { personalData } from '../data/personal.js';

// Sort news by date (newest first)
const sortedNews = newsData.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Format date function
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  return date.toLocaleDateString('en-US', options);
}

// Get relative time (e.g., "2 days ago")
function getRelativeTime(dateString: string): string {
  const date = new Date(dateString);
  const now = new Date();
  const diffTime = Math.abs(now.getTime() - date.getTime());
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  
  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
  return `${Math.floor(diffDays / 365)} years ago`;
}

// Get featured projects (for homepage)
const featuredProjects = projectsData.filter(p => p.featured).slice(0, 2);
---

<Layout title={`${personalData.name} - ${personalData.title}`}>
  <Header />
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <section class="mb-16">
      <div class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-medium mb-4">{personalData.name}</h1>
        <p class="text-xl text-secondary dark:text-gray-400 mb-2">
          {personalData.title}
        </p>
        <p class="text-secondary dark:text-gray-400">
          {personalData.shortBio}
        </p>
      </div>
      
      <div class="prose prose-lg dark:prose-invert max-w-3xl mx-auto">
        <p>
          {personalData.bio}
        </p>
      </div>

      <div class="mt-8 text-center">
        <p class="text-secondary dark:text-gray-400 mb-4">
          <strong>{personalData.name}</strong><br />
          {personalData.location}
        </p>
        <div class="flex justify-center space-x-4">
          <a
            href={`mailto:${personalData.socialLinks.mail}`}
            class="inline-flex items-center px-4 py-2 bg-dark-background dark:bg-background text-dark-text dark:text-text rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
          >
            Mail me
          </a>
          <a
            href={personalData.socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          >
            View on Github
          </a>
        </div>
      </div>
    </section>

    <!-- News Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8">News</h2>
      <div class="relative">
        <!-- Timeline line - extended upward for in-progress section -->
        <div class="absolute left-4 -top-6 bottom-0 w-0.5 bg-gray-300 dark:bg-gray-700"></div>
        
        <!-- Small "In progress..." text to the right of timeline -->
        <div class="relative pl-12 -mb-4">
          <p class="text-xs text-secondary dark:text-gray-400 italic">In progress...</p>
        </div>
        
        <div class="space-y-6 mt-6">
          <!-- News Items -->
          {sortedNews.map((item, index) => (
            <article class="relative pl-12">
              <!-- Timeline dot -->
              <div class="absolute left-3 top-1 w-3 h-3 rounded-full bg-primary dark:bg-blue-400 border-2 border-white dark:border-dark-background z-10"></div>
              
              <!-- Outline box for each news item -->
              <div class="border border-slate-200 dark:border-slate-800 rounded-lg p-5 bg-white dark:bg-slate-900 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-shadow">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-2">
                  <div>
                    <h3 class="text-lg font-semibold text-text dark:text-dark-text mb-1">
                      {item.title}
                    </h3>
                    {item.category && (
                      <span class="inline-block text-xs font-medium px-2 py-1 rounded bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 border border-blue-200 dark:border-blue-800">
                        {item.category}
                      </span>
                    )}
                  </div>
                  <div class="text-sm text-secondary dark:text-gray-400 flex-shrink-0">
                    <time datetime={item.date} title={formatDate(item.date)}>
                      {formatDate(item.date)}
                    </time>
                    <span class="ml-2 text-xs">({getRelativeTime(item.date)})</span>
                  </div>
                </div>
                
                <p
                  class="text-text dark:text-gray-300 leading-relaxed"
                  set:html={item.content}
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Recent Projects Section -->
    <section class="mb-16">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold">Some Projects</h2>
        <a href="/projects" class="text-secondary dark:text-blue-300 hover:text-text dark:hover:text-blue-200 inline-flex items-center gap-1">
          All projects
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6 hover:shadow-lg transition-shadow flex flex-col">
            <div class="flex items-center space-x-2 mb-2">
              {project.tags.map((tag) => (
                <span class="inline-block text-xs font-medium px-2 py-1 rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 border border-green-200 dark:border-green-800">{tag}</span>
              ))}            
            </div>
            <h3 class="text-xl font-bold mb-2">{project.title}</h3>
            <p
              class="text-secondary dark:text-gray-400 mb-4"
              set:html={project.description}
            />
            <div class="flex gap-6 flex-wrap mt-auto">
              {project.links.playStore && (
                <a 
                  href={project.links.playStore} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 group"
                >
                  Play Store
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">
                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                  </svg>
                </a>
              )}
              {project.links.website && (
                <a 
                  href={project.links.website} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 group"
                >
                  Website
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">
                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                  </svg>
                </a>
              )}
              {project.links.demo && project.links.demo !== '#' && (
                <a 
                  href={project.links.demo} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 group"
                >
                  Demo
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">
                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
