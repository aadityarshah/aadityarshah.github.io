---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { entrySlug, formatDate, getAtlasContent, readingTime, topicSlug } from '../lib/atlas';
const { notes } = await getAtlasContent();
---

<Layout title="Notes — Aaditya Shah" description="Field reports, technical notes, essays, and reflections from questions in motion.">
  <Header />
  <main id="main-content" class="notes-page">
    <header class="page-hero"><div class="shell"><p class="eyebrow">Notes</p><h1>Working explanations.</h1><p>Field reports, technical notes, and reflections. Some record a result. Others preserve the path that made the result understandable.</p></div></header>
    <section class="page-body"><div class="shell">
      <ul class="note-list">
        {notes.map((note) => <li class="note-item"><div><time class="meta" datetime={note.data.date.toISOString()}>{formatDate(note.data.date, 'short')}</time><span class="kind">{note.data.kind}</span></div><div><a href={`/notes/${entrySlug(note)}/`}><h2>{note.data.title}</h2></a><p>{note.data.description}</p><div class="modes meta"><span>{readingTime(note.body)}</span><span class="tag-list">{note.data.topics.map((topic) => <a class="tag-chip" href={`/tags/${topicSlug(topic)}/`}>{topic}</a>)}</span></div></div></li>)}
      </ul>
    </div></section>
  </main>
  <Footer />
</Layout>

<style>
  .note-item { grid-template-columns: 150px 1fr; padding: 2rem 0; }
  .note-item h2 { font-family: var(--display); font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 460; line-height: 1.08; margin-bottom: .75rem; }
  .note-item .kind { display: block; color: var(--rust); margin-top: .45rem; }
  @media (max-width: 700px) {
    .note-item { grid-template-columns: minmax(0, 1fr); gap: .5rem; padding-block: 1.25rem; }
    .note-item .kind { display: inline-block; margin: 0 0 0 .75rem; }
    .note-item .modes { margin-top: .75rem; }
  }
</style>
