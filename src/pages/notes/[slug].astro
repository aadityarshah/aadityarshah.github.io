---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { entrySlug, formatDate, getAtlasContent, readingTime, topicSlug } from '../../lib/atlas';

export async function getStaticPaths() {
  const { notes, questions, investigations } = await getAtlasContent();
  return notes.map((note) => ({ params: { slug: entrySlug(note) }, props: {
    note,
    questions: questions.filter((item) => note.data.relatedQuestions.includes(item.id)),
    investigations: investigations.filter((item) => note.data.relatedInvestigations.includes(item.id)),
  } }));
}
interface Props { note: CollectionEntry<'notes'>; questions: CollectionEntry<'questions'>[]; investigations: CollectionEntry<'investigations'>[]; }
const { note, questions, investigations } = Astro.props;
const { Content } = await render(note);
---

<Layout title={`${note.data.title} — Notes`} description={note.data.description} image={note.data.banner?.avif ?? note.data.banner?.png} type="article">
  <Header />
  <main id="main-content" class={note.data.banner ? 'detail-page has-cover' : 'detail-page'}>
    <header class="detail-header"><div class="shell"><p class="eyebrow">{note.data.kind.replace('-', ' ')}</p><h1>{note.data.title}</h1><p class="detail-question">{note.data.description}</p><div class="detail-meta meta"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time><span>{readingTime(note.body)}</span>{note.data.topics.map((topic) => <a href={`/tags/${topicSlug(topic)}/`}>{topic}</a>)}</div></div></header>
    {note.data.banner && <div class="cover-image-frame shell detail-banner" data-reveal><picture><source srcset={note.data.banner.avif} type="image/avif" /><img class="cover-image" src={note.data.banner.png} alt={note.data.banner.alt} loading="eager" /></picture><div class="cover-image-copy"><p class="eyebrow">{note.data.kind.replace('-', ' ')}</p><h1>{note.data.title}</h1><p class="detail-question">{note.data.description}</p><div class="detail-meta meta"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time><span>{readingTime(note.body)}</span>{note.data.topics.map((topic) => <a href={`/tags/${topicSlug(topic)}/`}>{topic}</a>)}</div></div></div>}
    <div class="shell detail-grid">
      <article class="prose"><Content /></article>
      <aside class="detail-aside" aria-label="Related material">
        <div class="aside-block"><h2>Published</h2><span class="meta">{formatDate(note.data.date)}</span></div>
        {questions.length > 0 && <div class="aside-block"><h2>Related questions</h2>{questions.map((question) => <a href={`/questions/${question.id}/`}>{question.data.title}</a>)}</div>}
        {investigations.length > 0 && <div class="aside-block"><h2>Related investigations</h2>{investigations.map((item) => <a href={`/projects/${item.id}/`}>{item.data.title}</a>)}</div>}
        <div class="aside-block"><a href="/notes">← All notes</a></div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>
