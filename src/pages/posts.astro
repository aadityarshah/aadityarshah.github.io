---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { personalData } from '../data/personal.js';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date): string {
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  return date.toLocaleDateString('en-US', options);
}

function getPostSlug(post: (typeof posts)[number]): string {
  return post.data.slug ?? post.id;
}

function getPostTags(post: (typeof posts)[number]): string[] {
  return post.data.tags?.length ? post.data.tags : post.data.category ? [post.data.category] : [];
}

function getReadingTime(post: (typeof posts)[number]): string {
  const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(wordCount / 200));
  return `${minutes} min read`;
}
---

<Layout title={`Posts - ${personalData.name}`}>
  <Header />
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 animate-in fade-in slide-in-from-bottom-4 animate-speed-fast">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight mb-2">Posts</h1>
      <p class="text-slate-500 dark:text-slate-500 text-lg">Sharing my thoughts and experiences.</p>
    </div>

    <div class="grid gap-8">
      {posts.map((post) => (
        <article class="group bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm border border-slate-200 dark:border-slate-800 rounded-2xl p-8 hover:border-blue-500/50 dark:hover:border-blue-400/50 hover:shadow-xl hover:shadow-blue-500/5 transition-all relative overflow-hidden">
          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <time datetime={post.data.date.toISOString()} class="text-sm font-medium text-slate-500 dark:text-slate-500">
                {formatDate(post.data.date)}
              </time>
              <span class="text-sm font-medium text-slate-500 dark:text-slate-500">{getReadingTime(post)}</span>
              {getPostTags(post).map((tag) => (
                <a
                  href={`/tags/${tag.toLowerCase()}`}
                  class="text-[10px] uppercase tracking-widest font-bold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 !text-slate-700 dark:!text-slate-200 border border-slate-200 dark:border-slate-700 relative z-40 transition-colors hover:bg-blue-50 hover:!text-blue-700 hover:border-blue-200 dark:hover:bg-blue-500/10 dark:hover:!text-blue-300 dark:hover:border-blue-500/30"
                >
                  {tag}
                </a>
              ))}
            </div>

            <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-1 transition-colors">
              <a class="!text-slate-900 dark:!text-slate-100" href={`/posts/${getPostSlug(post)}/`}>{post.data.title}</a>
            </h2>

            <p class="text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
              {post.data.description}
            </p>

            <a
              href={`/posts/${getPostSlug(post)}/`}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors w-fit"
            >
              Read post
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-1">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
