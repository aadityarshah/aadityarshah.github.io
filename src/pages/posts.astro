---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { personalData } from '../data/personal.js';
---

<Layout title={`Posts - ${personalData.name}`}>
  <Header />
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold mb-8">Posts</h1>
    <div class="space-y-6">
      <article class="border-b border-gray-200 dark:border-gray-800 pb-6">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Coming soon...</p>
        <h2 class="text-2xl font-bold mb-2">Blog posts will appear here</h2>
        <p class="text-gray-600 dark:text-gray-400">
          Check back later for updates on Android development, React, and more!
        </p>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
