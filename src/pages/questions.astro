---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAtlasContent } from '../lib/atlas';
const { questions } = await getAtlasContent();
---

<Layout title="Questions — Aaditya Shah" description="Open questions across mathematics, computation, quantum computing, cryptography, and related curiosities.">
  <Header />
  <main id="main-content">
    <header class="page-hero"><div class="shell"><h1>Questions I’m exploring</h1><p>These are questions I keep coming back to. Some have become investigations. Others are things I have only started exploring.</p></div></header>
    <section class="page-body"><div class="shell question-grid">
      {questions.map((question) => <a class="question-card" href={`/questions/${question.id}/`}><h2>{question.data.title}</h2><p>{question.data.summary}</p><footer><span class="status">{question.data.status}</span><span class="tag-list">{question.data.domains.map((domain) => <span class="topic tag-chip">{domain}</span>)}</span></footer></a>)}
    </div></section>
  </main>
  <Footer />
</Layout>
