---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { entrySlug, formatDate, getAtlasContent, topicSlug } from '../../lib/atlas';

type TopicProps = {
  label: string;
  questions: CollectionEntry<'questions'>[];
  investigations: CollectionEntry<'investigations'>[];
  notes: CollectionEntry<'notes'>[];
};

export async function getStaticPaths() {
  const atlas = await getAtlasContent();
  const labels = [...new Set([...atlas.questions.flatMap((item) => item.data.domains), ...atlas.notes.flatMap((item) => item.data.topics)])];
  return labels.map((label) => {
    const questions = atlas.questions.filter((item) => item.data.domains.some((domain) => topicSlug(domain) === topicSlug(label)));
    const questionIds = new Set(questions.map((item) => item.id));
    const notes = atlas.notes.filter((item) => item.data.topics.some((topic) => topicSlug(topic) === topicSlug(label)));
    const investigations = atlas.investigations.filter((item) => item.data.relatedQuestions.some((id) => questionIds.has(id)));
    return { params: { tag: topicSlug(label) }, props: { label, questions, investigations, notes } };
  });
}

const { label, questions, investigations, notes } = Astro.props as TopicProps;
---

<Layout title={`${label} — Topics`} description={`Questions, investigations, and notes connected to ${label}.`}>
  <Header />
  <main id="main-content">
    <header class="page-hero"><div class="shell"><p class="eyebrow">Topic</p><h1>{label}</h1><p>{questions.length} questions · {investigations.length} investigations · {notes.length} notes</p></div></header>
    {questions.length > 0 && <section class="section"><div class="shell"><header class="section-head"><div><p class="eyebrow">Questions</p><h2 class="section-title">What this subject opens.</h2></div></header><div class="question-grid">{questions.map((question, index) => <a class="question-card" href={`/questions/${question.id}/`}><span class="index-number">Q.{String(index + 1).padStart(2, '0')}</span><h3>{question.data.title}</h3><p>{question.data.summary}</p><footer><span class="status">{question.data.status}</span></footer></a>)}</div></div></section>}
    {investigations.length > 0 && <section class="section"><div class="shell"><header class="section-head"><div><p class="eyebrow">Investigations</p><h2 class="section-title">Where it became concrete.</h2></div></header><div class="investigation-list">{investigations.map((item, index) => <a class="investigation-row" href={`/projects/${item.id}/`}><span class="index-number">I.{String(index + 1).padStart(2, '0')}</span><div><h3>{item.data.title}</h3><p class="investigation-question">{item.data.question}</p></div><div class="investigation-summary"><p>{item.data.summary}</p></div><span class="arrow">↗</span></a>)}</div></div></section>}
    {notes.length > 0 && <section class="section"><div class="shell"><header class="section-head"><div><p class="eyebrow">Notes</p><h2 class="section-title">Writing connected to the thread.</h2></div></header><ul class="note-list">{notes.map((note) => <li class="note-item"><time class="meta" datetime={note.data.date.toISOString()}>{formatDate(note.data.date, 'short')}</time><div><a href={`/notes/${entrySlug(note)}/`}><h3>{note.data.title}</h3></a><p>{note.data.description}</p></div></li>)}</ul></div></section>}
    {questions.length + investigations.length + notes.length === 0 && <div class="shell empty-state">Nothing has been indexed here yet.</div>}
  </main>
  <Footer />
</Layout>
