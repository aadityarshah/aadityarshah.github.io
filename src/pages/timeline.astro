---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDate, getAtlasContent } from '../lib/atlas';
const { trail } = await getAtlasContent();
---

<Layout title="Trail — Aaditya Shah" description="A chronological record of questions pursued, systems built, and ideas revisited.">
  <Header />
  <main id="main-content">
    <header class="page-hero"><div class="shell"><p class="eyebrow">Trail</p><h1>Attention, accumulated.</h1><p>A chronological record of beginnings, releases, changing responsibilities, and questions that continued after the formal endpoint.</p></div></header>
    <section class="page-body"><div class="shell"><ol class="trail-list trail-page">
      {trail.map((entry, index) => <li class="trail-item"><div class="trail-date"><span class="index-number">T.{String(trail.length - index).padStart(2, '0')}</span><time class="meta" datetime={entry.data.date.toISOString()}>{entry.data.dateLabel ?? formatDate(entry.data.date)}</time></div><div><span class="kind">{entry.data.kind}</span><h2>{entry.data.url ? <a href={entry.data.url} target={entry.data.url.startsWith('http') ? '_blank' : undefined} rel={entry.data.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{entry.data.title}</a> : entry.data.title}</h2><p>{entry.data.summary}</p></div></li>)}
    </ol></div></section>
  </main>
  <Footer />
</Layout>

<style>
  .trail-page .trail-item { display: grid; grid-template-columns: 210px 1fr; gap: 3rem; padding: 2.3rem 0 2.3rem 2rem; }
  .trail-page h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
  .trail-date { display: grid; align-content: start; gap: .5rem; }
  .kind { color: var(--rust); }
  @media (max-width: 700px) { .trail-page .trail-item { grid-template-columns: 1fr; gap: 1rem; } }
</style>
