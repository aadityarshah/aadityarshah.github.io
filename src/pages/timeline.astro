---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatDate, getAtlasContent } from '../lib/atlas';
const { trail } = await getAtlasContent();
---

<Layout title="Trail — Aaditya Shah" description="A chronological record of questions pursued, systems built, and ideas revisited.">
  <Header />
  <main id="main-content">
    <header class="page-hero"><div class="shell"><p class="eyebrow">Trail</p><h1>Attention, accumulated.</h1><p>A chronological record of beginnings, releases, changing responsibilities, and questions that continued after the formal endpoint.</p></div></header>
    <section class="page-body"><div class="shell"><ol class="trail-list trail-page">
      {trail.map((entry) => <li class="trail-item"><div class="trail-date"><time class="meta" datetime={entry.data.date.toISOString()}>{entry.data.dateLabel ?? formatDate(entry.data.date)}</time></div><div><span class="kind">{entry.data.kind}</span><h2>{entry.data.url ? <a href={entry.data.url} target={entry.data.url.startsWith('http') ? '_blank' : undefined} rel={entry.data.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{entry.data.title}</a> : entry.data.title}</h2><p>{entry.data.summary}</p></div></li>)}
    </ol></div></section>
  </main>
  <Footer />
</Layout>

<style>
  .trail-page .trail-item {
    --row-padding: 1.4rem;
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: var(--row-padding) 0 var(--row-padding) 1.4rem;
  }
  .trail-page .trail-item::before { top: calc(var(--row-padding) + .5rem - 3.5px); }
  .trail-page h2 { margin: .25rem 0 .4rem; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.25; font-weight: 600; }
  .trail-page h2 a { text-decoration-thickness: 1px; }
  .trail-page p { max-width: 72ch; line-height: 1.5; }
  .trail-date time, .kind { display: block; }
  .kind { color: var(--rust); }
  @media (max-width: 700px) {
    .trail-page .trail-item { --row-padding: 1.05rem; grid-template-columns: minmax(0, 1fr); gap: .35rem; padding-left: 1rem; }
  }
</style>
