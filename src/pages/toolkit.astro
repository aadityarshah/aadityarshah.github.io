---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { personalData } from '../data/personal.js';

const toolkit = [
  {
    category: "Computing",
    items: [
      { name: "Windows 11", slug: "windows11", color: "0078D4", description: "My primary OS for development and everyday tasks.", link: "https://www.microsoft.com/windows" },
      { name: "Ubuntu", slug: "ubuntu", color: "E95420", description: "My secondary OS, used for Linux-based development and server tasks.", link: "https://ubuntu.com" },
      { name: "Android", slug: "android", color: "3DDC84", description: "The platform I build for, using a physical device for testing.", link: "https://www.android.com" },
    ]
  },
  {
    category: "Development",
    items: [
      { name: "VS Code", slug: "visualstudiocode", color: "007ACC", description: "My main editor for Web, React Native, and scripting.", link: "https://code.visualstudio.com" },
      { name: "Android Studio", slug: "androidstudio", color: "3DDC84", description: "The powerhouse for all my Kotlin and Java Android work.", link: "https://developer.android.com/studio" },
      { name: "Kotlin", slug: "kotlin", color: "7F52FF", description: "My language of choice for robust Android applications.", link: "https://kotlinlang.org" },
      { name: "React Native", slug: "react", color: "61DAFB", description: "Used for building cross-platform mobile experiences.", link: "https://reactnative.dev" },
      { name: "GitHub", slug: "github", color: "181717", description: "Where all my code lives and where I collaborate.", link: "https://github.com" },
    ]
  },
  {
    category: "Apps & Productivity",
    items: [
      { name: "Firebase", slug: "firebase", color: "FFCA28", description: "Used for backend services, hosting, and analytics.", link: "https://firebase.google.com" },
      { name: "Hugging Face", slug: "huggingface", color: "FFD21E", description: "The platform I use for integrating AI models into apps.", link: "https://huggingface.co" },
      { name: "Notion", slug: "notion", color: "000000", description: "My second brain for project management and notes.", link: "https://www.notion.so" },
    ]
  }
];
---

<Layout title={`Toolkit - ${personalData.name}`}>
  <Header />
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 animate-in fade-in slide-in-from-bottom-4 animate-speed-fast">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight mb-2">Toolkit</h1>
      <p class="text-slate-500 dark:text-slate-500 text-lg">The software, hardware, and tools I use every day.</p>
    </div>

    <div class="space-y-16">
      {toolkit.map((group) => (
        <section>
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-xl font-bold tracking-tight text-slate-400 dark:text-slate-500 uppercase whitespace-nowrap">{group.category}</h2>
            <div class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></div>
            <div class="hidden sm:flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
              <span>Scroll</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </div>
          
          <div class="flex overflow-x-auto pb-6 gap-6 snap-x snap-mandatory scrollbar-hide -mx-4 px-4 sm:mx-0 sm:px-0">
            {group.items.map((item) => {
              // Logic to handle dark logos in dark mode
              const isDarkColor = ['000000', '181717'].includes(item.color);
              const displayColor = isDarkColor ? 'white' : `#${item.color}`;
              
              return (
                <a 
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex-shrink-0 w-64 h-64 snap-start bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm border border-slate-200 dark:border-slate-800 rounded-3xl p-8 hover:shadow-xl transition-all duration-300 flex flex-col items-center justify-center text-center relative overflow-hidden"
                  style={`--brand-color: #${item.color}; --display-color: ${displayColor};`}
                >
                  {/* Adaptive Hover Border */}
                  <style is:inline define:vars={{ brandColor: `#${item.color}`, hoverColor: displayColor }}>
                    .group:hover {
                      border-color: var(--brandColor) !important;
                    }
                    :global(.dark) .group:hover {
                      border-color: var(--hoverColor) !important;
                      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 0 20px -5px var(--hoverColor) !important;
                    }
                    /* Standard Shadow for Light Mode */
                    .group:hover {
                      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 0 20px -5px var(--brandColor) !important;
                    }
                  </style>

                  <div class="relative w-16 h-16 mb-6">
                    {/* Dynamic Brand Glow behind the white stage */}
                    <div 
                      class="absolute inset-0 rounded-2xl blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"
                      style={`background-color: var(--hoverColor);`}
                    ></div>
                    
                    {/* Clean White Stage */}
                    <div class="relative w-full h-full flex items-center justify-center transition-transform duration-500 group-hover:scale-110 bg-white rounded-2xl shadow-sm border border-slate-100 p-3 z-10">
                      <img 
                        src={`https://api.iconify.design/simple-icons:${item.slug}.svg?color=%23${item.color}`} 
                        alt={`${item.name} logo`}
                        class="w-full h-full object-contain"
                        loading="lazy"
                        onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${item.name[0]}&background=f8fafc&color=0ea5e9&bold=true';`}
                      />
                    </div>
                  </div>

                  <div class="relative z-10">
                    <h3 class="font-bold text-xl text-slate-900 dark:text-slate-100 mb-2 transition-colors group-hover:text-[var(--brand-color)] dark:group-hover:text-[var(--display-color)]">
                      {item.name}
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 leading-snug">
                      {item.description}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
